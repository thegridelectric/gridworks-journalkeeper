# journalkeeper convenience aliases — pure spelling over systemctl/tail,
# no logic. Sourced from the box login's ~/.bashrc at box setup; the
# sudoers drop-in (/etc/sudoers.d/journalkeeper) grants exactly these
# systemctl invocations.
alias gjkstart='sudo systemctl start journalkeeper'
alias gjkstop='sudo systemctl stop journalkeeper'
alias gjkrestart='sudo systemctl restart journalkeeper'
alias gjkstatus='systemctl status journalkeeper --no-pager'
alias gjklog='cd "$HOME"/.local/state/gridworks/journalkeeper/log && tail -F *.log'
