[Unit]
Description=GridWorks JournalKeeper service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# Repo root as CWD so Settings' env_file=".env" resolves to the repo's .env.
WorkingDirectory=/home/ubuntu/gridworks-journalkeeper
ExecStart=/home/ubuntu/gridworks-journalkeeper/.venv/bin/python \
    /home/ubuntu/gridworks-journalkeeper/run_journal_keeper.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
